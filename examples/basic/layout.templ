package main

// layout wraps body in an HTML page with Bootstrap 5 and htmx from CDN.
templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link
				href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
				rel="stylesheet"
			/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
		</head>
		<body>
			<div class="container py-5">
				<h1 class="mb-4">{ title }</h1>
				{ children... }
			</div>
		</body>
	</html>
}

// actionButtons renders per-row Edit/Delete buttons wired to HTMX.
templ actionButtons(id int) {
	<div class="btn-group btn-group-sm" role="group">
		<button
			type="button"
			class="btn btn-outline-secondary"
			hx-get={ "/people/" + toStr(id) + "/edit" }
			hx-include="#table-form"
			hx-target="#table-form"
			hx-swap="outerHTML"
		>
			Edit
		</button>
		<button
			type="button"
			class="btn btn-outline-danger"
			hx-delete={ "/people/" + toStr(id) }
			hx-confirm="Delete this person?"
			hx-target="#table-form"
			hx-swap="outerHTML"
		>
			Delete
		</button>
	</div>
}

templ editForm(model editFormModel, endpoint string) {
	<form id="table-form" hx-post={ "/people/" + toStr(model.ID) + "/edit" } hx-target="#table-form" hx-swap="outerHTML">
		<input type="hidden" name="sort" value={ model.State.SortKey }/>
		<input type="hidden" name="dir" value={ model.State.SortDir }/>
		<input type="hidden" name="page" value={ toStr(model.State.Page) }/>
		<input type="hidden" name="page_size" value={ toStr(model.State.PageSize) }/>
		<input type="hidden" name="search" value={ model.State.Search }/>
		<div class="card">
			<div class="card-body">
				<h2 class="h5 card-title">Edit person</h2>
				<div class="mb-3">
					<label for="edit-name" class="form-label">Name</label>
					<input id="edit-name" name="name" value={ model.Name } class={ "form-control", templ.KV("is-invalid", model.NameErr != "") } required/>
					if model.NameErr != "" {
						<div class="invalid-feedback">{ model.NameErr }</div>
					}
				</div>
				<div class="mb-3">
					<label for="edit-age" class="form-label">Age</label>
					<input id="edit-age" name="age" type="number" min="1" max="120" value={ model.Age } class={ "form-control", templ.KV("is-invalid", model.AgeErr != "") } required/>
					if model.AgeErr != "" {
						<div class="invalid-feedback">{ model.AgeErr }</div>
					}
				</div>
				<div class="mb-3">
					<label for="edit-email" class="form-label">Email</label>
					<input id="edit-email" name="email" type="email" value={ model.Email } class={ "form-control", templ.KV("is-invalid", model.EmailErr != "") } required/>
					if model.EmailErr != "" {
						<div class="invalid-feedback">{ model.EmailErr }</div>
					}
				</div>
				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-primary">Save</button>
					<button type="button" class="btn btn-secondary" hx-get={ endpoint } hx-include="#table-form" hx-target="#table-form" hx-swap="outerHTML">Cancel</button>
				</div>
			</div>
		</div>
	</form>
}
