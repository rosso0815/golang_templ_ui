package main

import "github.com/rosso0815/rosso0815-go-ui-templ/table"

templ Demo(vm table.TableViewModel) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>People directory - Table demo</title>
			<link
				href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
				rel="stylesheet"
			/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body class="bg-light">
			<main class="container py-5">
				<header class="mb-4">
					<p class="text-primary fw-semibold mb-2">Go + templ + HTMX</p>
					<h1 class="display-6 fw-bold">People directory</h1>
					<p class="text-secondary mb-0">
						A small, server-rendered table demo. Search by name, email, role, or department; click a heading to sort.
					</p>
				</header>
				<section class="card border-0 shadow-sm">
					<div class="card-body p-4">
						@table.Fragment(vm, "/people/table")
					</div>
				</section>
				<p class="small text-secondary mt-3">
					Search, sorting, and pagination update this table without a full-page reload.
				</p>
			</main>
		</body>
	</html>
}

templ personName(p person) {
	<div class="fw-semibold">{ p.Name }</div>
	<div class="small text-secondary">{ p.Email }</div>
}
